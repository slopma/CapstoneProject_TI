# Backend
INVENTORY_PATH=./inventory/onprem-example.json
AWS_OUTPUT_PATH=./generated/aws/main.tf
CORS_ORIGINS=http://localhost:5173
GITHUB_TOKEN= # Optional GitHub PAT to raise GitHub API rate limits from 60 to 5,000 req/hr

# Frontend development proxy
VITE_API_PROXY_TARGET=http://localhost:8001
VITE_API_URL=/api

# Terraform values are supplied separately through generated/aws/terraform.tfvars.