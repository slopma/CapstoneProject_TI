# Environment & secrets (keep examples)
.env
.env.*
!.env.example

# Terraform generated files & credentials
**/.terraform/
**/*.tfstate
**/*.tfstate*
**/*.tfvars
**/*.tfvars.json
**/tfplan
deploy/aws/*id_*
deploy/aws/*.pem
deploy/aws/*.pub
**/*id_rsa*
**/*id_ed25519*
**/*.pem
**/*.key
generated/aws/plan-evidence.txt

# Python & test caches
__pycache__/
*.py[cod]
.pytest_cache/
.venv/

# Frontend / Node build & OS artifacts
node_modules/
dist/
dist-ssr/
*.log
.DS_Store
*.bak

# Local AI / editor tooling directories
.codex/
.cursor/
.gemini/
.grok/
.impeccable/

# User discovery inventories & local session artifacts (Privacy & Data Quality)
docs/cloudmove-osquery-inventory.json
*osquery-inventory*.json
cloudmove-parsed/

# Generated VM images and deployment packages
/generated/staging_images/
generated/deployments/
*.zip

# Runtime SQLite databases, UC2 staging & session state
backend/data/*.db
backend/data/*.db-journal
backend/data/*.db-wal
backend/data/*.db-shm
backend/data/*.db.bak
backend/data/discovery_sessions/
backend/data/uc2_staged/
backend/data/*.json
backend/data/*.json.bak
!backend/data/.gitkeep
