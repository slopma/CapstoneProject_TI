# Dynamic secure credentials generation (zero hardcoded secrets)
resource "random_password" "db_master_password" {
  length  = 24
  special = false
}

locals {
  effective_db_password = var.db_password != null && var.db_password != "" ? var.db_password : random_password.db_master_password.result
}

# VPC Network & Subnetwork Boundaries
resource "google_compute_network" "target_vpc" {
  name                    = "cloudmove-target-vpc"
  auto_create_subnetworks = false
  routing_mode            = "REGIONAL"
}

resource "google_compute_subnetwork" "primary_subnet" {
  name                     = "cloudmove-primary-subnet"
  ip_cidr_range            = var.subnet_cidr
  region                   = var.gcp_region
  network                  = google_compute_network.target_vpc.id
  private_ip_google_access = true
}

resource "google_compute_firewall" "allow_internal_and_web" {
  name    = "cloudmove-allow-web-internal"
  network = google_compute_network.target_vpc.name
  allow {
    protocol = "tcp"
    ports    = ["22", "80", "443", "5432", "6379", "8000", "8080"]
  }
  source_ranges = ["10.0.0.0/8"]
  target_tags   = ["cloudmove-workload"]
}

resource "google_service_account" "workload_sa" {
  account_id   = "cloudmove-workload-sa"
  display_name = "CloudMove Migrated Workload Service Account"
}

# Migrated GCP Resource: Firewall Perimetral & DMZ (firewall-dmz)
# Migrated GCP Resource: VM Servidor Backend API (Ubuntu Linux) (backend-api-vm)
resource "google_compute_instance" "backend_api_vm" {
  name         = "vm-servidor-backend-api-(ubuntu-linux)"
  machine_type = "e2-medium"
  zone         = var.gcp_zone
  tags         = ["cloudmove-workload"]
  boot_disk {
    initialize_params {
      image = var.custom_image_name != "" ? var.custom_image_name : "debian-cloud/debian-12"
      size  = 50
      type  = "pd-balanced"
    }
  }
  network_interface {
    subnetwork = google_compute_subnetwork.primary_subnet.id
  }
  service_account {
    email  = google_service_account.workload_sa.email
    scopes = ["cloud-platform"]
  }
  labels = {
    cmir_id    = "backend_api_vm"
    managed_by = "cloudmove"
  }
}

# Migrated GCP Resource: Servicio Autenticación JWT (auth-jwt-srv)
resource "google_compute_instance" "auth_jwt_srv" {
  name         = "servicio-autenticación-jwt"
  machine_type = "e2-medium"
  zone         = var.gcp_zone
  tags         = ["cloudmove-workload"]
  boot_disk {
    initialize_params {
      image = var.custom_image_name != "" ? var.custom_image_name : "debian-cloud/debian-12"
      size  = 50
      type  = "pd-balanced"
    }
  }
  network_interface {
    subnetwork = google_compute_subnetwork.primary_subnet.id
  }
  service_account {
    email  = google_service_account.workload_sa.email
    scopes = ["cloud-platform"]
  }
  labels = {
    cmir_id    = "auth_jwt_srv"
    managed_by = "cloudmove"
  }
}

# Migrated GCP Resource: Servidor Caché Redis On-Prem (redis-cache)
resource "google_redis_instance" "redis_cache" {
  name               = "servidor-caché-redis-on-prem-redis"
  tier               = "BASIC"
  memory_size_gb     = 1
  region             = var.gcp_region
  authorized_network = google_compute_network.target_vpc.id
  redis_version      = "REDIS_7_0"
  labels = {
    cmir_id    = "redis_cache"
    managed_by = "cloudmove"
  }
}

# Migrated GCP Resource: Almacenamiento SAN/NFS Compartido (nfs-storage)
resource "google_storage_bucket" "nfs_storage" {
  name                        = "cloudmove-almacenamiento-san-nfs-compartido"
  location                    = var.gcp_region
  uniform_bucket_level_access = true
  force_destroy               = true
  labels = {
    cmir_id    = "nfs_storage"
    managed_by = "cloudmove"
  }
}
