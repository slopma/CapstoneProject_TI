terraform {
  required_version = ">= 1.5.0"
  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 5.0"
    }
  }
}

provider "aws" {
  region = var.aws_region
}

variable "aws_region" {
  description = "Target AWS Region"
  type        = string
  default     = "us-east-1"
}

variable "environment" {
  description = "Target Deployment Environment"
  type        = string
  default     = "production"
}

variable "vpc_cidr" {
  description = "CIDR block for the target VPC"
  type        = string
  default     = "10.0.0.0/16"
}

variable "db_password" {
  description = "Database Master Password (Sensitive)"
  type        = string
  sensitive   = true
  default     = "ChangeMeInProduction123!"
}

# ------------------------------------------------------------
# Network & Isolation Boundaries
# ------------------------------------------------------------
resource "aws_vpc" "target_vpc" {
  cidr_block           = var.vpc_cidr
  enable_dns_support   = true
  enable_dns_hostnames = true
  tags = {
    Name        = "cloudmove-target-vpc"
    Environment = var.environment
  }
}

resource "aws_internet_gateway" "igw" {
  vpc_id = aws_vpc.target_vpc.id
  tags = {
    Name = "cloudmove-igw"
  }
}

resource "aws_subnet" "public_subnet" {
  vpc_id                  = aws_vpc.target_vpc.id
  cidr_block              = "10.0.1.0/24"
  map_public_ip_on_launch = true
  tags = {
    Name = "cloudmove-public-subnet"
  }
}

resource "aws_subnet" "private_subnet_a" {
  vpc_id            = aws_vpc.target_vpc.id
  cidr_block        = "10.0.2.0/24"
  availability_zone = "${var.aws_region}a"
  tags = {
    Name = "cloudmove-private-subnet-a"
  }
}

resource "aws_subnet" "private_subnet_b" {
  vpc_id            = aws_vpc.target_vpc.id
  cidr_block        = "10.0.3.0/24"
  availability_zone = "${var.aws_region}b"
  tags = {
    Name = "cloudmove-private-subnet-b"
  }
}

resource "aws_security_group" "app_sg" {
  name        = "cloudmove-app-sg"
  description = "Security group for migrated application workloads"
  vpc_id      = aws_vpc.target_vpc.id
  ingress {
    from_port   = 80
    to_port     = 80
    protocol    = "tcp"
    cidr_blocks = ["0.0.0.0/0"]
  }
  ingress {
    from_port   = 443
    to_port     = 443
    protocol    = "tcp"
    cidr_blocks = ["0.0.0.0/0"]
  }
  egress {
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }
  tags = {
    Name = "cloudmove-app-sg"
  }
}

resource "aws_security_group" "data_sg" {
  name        = "cloudmove-data-sg"
  description = "Security group for migrated data services"
  vpc_id      = aws_vpc.target_vpc.id
  ingress {
    from_port       = 5432
    to_port         = 5432
    protocol        = "tcp"
    security_groups = [aws_security_group.app_sg.id]
  }
  ingress {
    from_port       = 6379
    to_port         = 6379
    protocol        = "tcp"
    security_groups = [aws_security_group.app_sg.id]
  }
  egress {
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }
  tags = {
    Name = "cloudmove-data-sg"
  }
}

resource "aws_db_subnet_group" "db_subnets" {
  name       = "cloudmove-db-subnets"
  subnet_ids = [aws_subnet.private_subnet_a.id, aws_subnet.private_subnet_b.id]
  tags = {
    Name = "cloudmove-db-subnets"
  }
}

